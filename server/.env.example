PORT=3001
# Conexión PostgreSQL provista por Railway para guardar lubricentros.
DATABASE_URL=postgresql://usuario:password@host:5432/base
admin_panel=admin@example.com
admin_password=REEMPLAZAR_CON_TU_PASSWORD
ADMIN_JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_LARGO

# Bucket Railway: copiar valores de la pestaña Credentials del bucket.
# Solo en el servidor. No usar NEXT_PUBLIC_ para estas variables.
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_ACCESS_KEY_ID=REEMPLAZAR
AWS_SECRET_ACCESS_KEY=REEMPLAZAR
AWS_S3_BUCKET_NAME=REEMPLAZAR_CON_EL_NOMBRE_S3_COMPLETO
AWS_DEFAULT_REGION=auto
# Usar el estilo indicado por Railway: virtual (actual) o path (buckets antiguos).
AWS_S3_URL_STYLE=virtual
